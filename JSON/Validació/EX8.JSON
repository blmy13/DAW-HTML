{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id_comanda": {
      "type": "string",
      "pattern": "^CMD-[A-Za-z0-9]{4}$"
    },
    "tipus_enviament": {
      "type": "string",
      "enum": [
        "domicili",
        "recollida"
      ]
    },
    "total": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "id_comanda",
    "tipus_enviament",
    "total"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "tipus_enviament": {
            "const": "domicili"
          }
        }
      },
      "then": {
        "properties": {
          "adreça": {
            "type": "string"
          }
        },
        "required": [
          "adreça"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "tipus_enviament": {
            "const": "recollida"
          }
        }
      },
      "then": {
        "properties": {
          "botiga": {
            "type": "string"
          }
        },
        "required": [
          "botiga"
        ]
      }
    }
  ]
}