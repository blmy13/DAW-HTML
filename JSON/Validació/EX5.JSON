{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "minLength": 3
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "modalitat": {
      "type": "string",
      "enum": [
        "online",
        "presencial"
      ]
    }
  },
  "required": [
    "nom",
    "email",
    "modalitat"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "modalitat": {
            "const": "online"
          }
        }
      },
      "then": {
        "properties": {
          "plataforma": {
            "type": "string"
          }
        },
        "required": [
          "plataforma"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "modalitat": {
            "const": "presencial"
          }
        }
      },
      "then": {
        "properties": {
          "aula": {
            "type": "string"
          }
        },
        "required": [
          "aula"
        ]
      }
    }
  ]
}