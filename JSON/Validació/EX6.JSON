{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "codi": {
      "type": "string",
      "pattern": "^PROD-[0-9]{4}$"
    },
    "nom": {
      "type": "string"
    },
    "preu": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "codi",
    "nom",
    "preu"
  ],
  "if": {
    "properties": {
      "preu": {
        "exclusiveMaximum": 10
      }
    }
  },
  "then": {
    "properties": {
      "oferta": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "oferta"
    ]
  }
}