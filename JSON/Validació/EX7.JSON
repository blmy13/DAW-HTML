{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^USR-[0-9]{4}$"
          },
          "nom": {
            "type": "string"
          },
          "edat": {
            "type": "integer",
            "minimum": 16
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "nom",
          "edat",
          "email"
        ]
      }
    }
  },
  "required": [
    "participants"
  ]
}