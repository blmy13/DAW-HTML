{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 6
    },
    "preu": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nom": {
      "type": "string",
      "maxLength": 50
    }
  },
  "required": [
    "id",
    "preu",
    "nom"
  ]
}